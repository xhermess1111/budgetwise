{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start local web server",
      "type": "shell",
      "command": "\"C:\\Users\\gabri\\AppData\\Local\\Programs\\Python\\Python313\\python.exe\"",
      "args": [
        "-m",
        "http.server",
        "8000",
        "--bind",
        "127.0.0.1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": [
        {
          "owner": "http-server",
          "pattern": {
            "regexp": "^$",
            "file": 1,
            "location": 2,
            "message": 3
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": "Serving HTTP on .*"
          }
        }
      ]
    }
  ]
}
